10  PRINT "Mandelbrot - Tiny BASIC"
20  LET F=50
30  FOR Y = -12 TO 12
40  FOR X = -49 TO 29
50  LET C=X*229/100
60  LET D=Y*416/100
70  LET A=C
80  LET B=D
90  LET I=0
100 LET Q=B/F
110 LET S=B-(Q*F)
120 LET T=((A*A)-(B*B))/F+C
130 LET B=2*((A*Q)+(A*S/F))+D
140 LET A=T
150 LET I=I+1
160 IF I=16 GOTO 200
170 IF ((A*A)/F+(B*B)/F)<4*F GOTO 100
180 PRINT $32+I;
190 GOTO 210
200 PRINT " ";
210 NEXT X
220 PRINT ""
230 NEXT Y
240 END
